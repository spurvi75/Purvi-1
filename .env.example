# Copy this file to ".env" in the project root and adjust values as needed.
# config.py automatically loads ".env" via python-dotenv.

# --- Core Flask ---
SECRET_KEY=change-this-to-a-long-random-string
FLASK_ENV=development

# --- Database ---
# Default (SQLite, good for development):
# DATABASE_URL=sqlite:////absolute/path/to/instance/axis_guesthouse.db
#
# PostgreSQL example:
# DATABASE_URL=postgresql://username:password@localhost:5432/axis_guesthouse
#
# MySQL example (requires pymysql: pip install pymysql):
# DATABASE_URL=mysql+pymysql://username:password@localhost:3306/axis_guesthouse

# --- Password reset ---
PASSWORD_RESET_EXPIRY_MINUTES=30

# --- SMTP / Email ---
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your-smtp-username@example.com
MAIL_PASSWORD=your-smtp-app-password
MAIL_DEFAULT_SENDER=noreply@axisindia.in
# Set to False once real SMTP credentials above are configured, so emails
# actually get delivered instead of just being suppressed/logged.
MAIL_SUPPRESS_SEND=True

# --- Application ---
ADMIN_NOTIFICATION_EMAIL=Admin@axisindia.in
BOOKING_NUMBER_PREFIX=AXIS-GH
APP_BASE_URL=http://127.0.0.1:5000

# --- Security (production) ---
SESSION_COOKIE_SECURE=False
